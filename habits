#!/usr/bin/env python3
"""habits — an at-a-glance dashboard for the things a machine can already see.

Every window is a ROLLING 7 days ending today, never a calendar week.

Renders only. Everything slow (API calls, vault scans) happens in `habits refresh`
so that pulling this up is instant. Sources that are stale or missing render as a
dash with an age marker — never a fabricated value.

Subcommands:
    habits              the dashboard
    habits refresh      run every collector, then render
    habits journal      the day-by-day behind the journal row
    habits fast ...     log whether the eating window held

Config: ~/.config/habits/config.json
State:  ~/Code/tools/habits/state/{local,api,outreach,fasting}.json
"""

from __future__ import annotations

import argparse
import json
import statistics
import sys
from dataclasses import dataclass
from datetime import date, datetime, timedelta
from pathlib import Path

CONFIG_PATH = Path.home() / ".config" / "habits" / "config.json"
# In ~/Code, NOT ~/.local/state — Syncthing carries ~/Code, so the refresh can
# run on the always-on Mini and both machines render the same numbers.
STATE_DIR = Path.home() / "Code" / "tools" / "habits" / "state"
# One file per WRITER, never per metric — two processes sharing a file is the
# read-modify-write race that silently ate 53 of 60 concurrent vault writes.
# Adding a collector means adding its name here.
SOURCES = ("local", "api", "outreach", "fasting")

# Every metric: label, direction, threshold, unit renderer.
# direction "min" -> off track when value < threshold
# direction "max" -> off track when value > threshold  (days-since style)
DEFAULTS: dict = {
    "metrics": {
        "lifts": {"label": "lifts", "direction": "min", "threshold": 1, "unit": "count"},
        "sleep": {"label": "sleep", "direction": "min", "threshold": 6.0, "unit": "hours"},
        "rides": {"label": "rides", "direction": "min", "threshold": 3, "unit": "count"},
        "journal": {"label": "journal", "direction": "min", "threshold": 4, "unit": "days7"},
        "writing": {"label": "writing", "direction": "max", "threshold": 30, "unit": "daysago"},
        "outreach": {"label": "outreach", "direction": "min", "threshold": 3, "unit": "count"},
        # Mon–Fri only, so the denominator is 5 and a weekend cell is unknown,
        # never a miss. Derived from Window sessions by collect_fasting.py.
        "fasting": {"label": "fasting", "direction": "min", "threshold": 4, "unit": "weekdays"},
    },
    "surge_multiplier": 1.5,
    "stale_after_hours": 26,
}

RESET = "\033[0m"
DIM = "\033[2m"
BOLD = "\033[1m"
GREEN = "\033[32m"
RED = "\033[31m"
YELLOW = "\033[33m"


@dataclass
class Reading:
    key: str
    label: str
    value: float | None
    threshold: float
    direction: str
    unit: str
    note: str = ""
    history: list[float] | None = None
    days: list | None = None
    stale_hours: float | None = None
    provisional: bool = False
    denominator: int = 7

    @property
    def missing(self) -> bool:
        return self.value is None

    @property
    def off_track(self) -> bool:
        """Every window is a ROLLING 7 days, so this is always a fair comparison.

        Calendar weeks needed a whole pace/days-left apparatus to avoid calling
        you a failure every Monday, and the number only meant anything on Sunday.
        A rolling window deletes the problem instead of managing it.
        """
        if self.missing:
            return False
        if self.direction == "max":
            return self.value > self.threshold
        return self.value < self.threshold

    def surging(self, multiplier: float) -> bool:
        """Notably MORE active than usual — the other thing worth surfacing."""
        if self.missing or self.direction != "min" or not self.history:
            return False
        past = [h for h in self.history if h is not None]
        if len(past) < 3:
            return False
        median = statistics.median(past)
        return median > 0 and self.value >= median * multiplier


def load_config() -> dict:
    cfg = json.loads(json.dumps(DEFAULTS))
    if CONFIG_PATH.exists():
        try:
            user = json.loads(CONFIG_PATH.read_text())
        except (json.JSONDecodeError, OSError) as e:
            print(f"habits: bad config at {CONFIG_PATH}: {e}", file=sys.stderr)
            return cfg
        for key, val in user.items():
            if key == "metrics" and isinstance(val, dict):
                for mkey, mval in val.items():
                    # Only TUNE metrics the code knows about. A user file that
                    # names a retired metric used to conjure a spec with no
                    # `direction` and crash the whole dashboard on a KeyError —
                    # a stale threshold should be ignored, never fatal.
                    if mkey in cfg["metrics"]:
                        cfg["metrics"][mkey].update(mval)
            else:
                cfg[key] = val
    return cfg


def load_state() -> dict:
    """Merge every source file. One file per writer so concurrent refreshes
    cannot clobber each other — the failure mode that ate 53 of 60 vault writes."""
    merged: dict = {}
    for name in SOURCES:
        path = STATE_DIR / f"{name}.json"
        if not path.exists():
            continue
        try:
            blob = json.loads(path.read_text())
        except (json.JSONDecodeError, OSError):
            continue
        written = blob.get("written_at")
        for key, entry in (blob.get("metrics") or {}).items():
            entry.setdefault("written_at", written)
            merged[key] = entry
    return merged


def hours_since(stamp: str | None) -> float | None:
    if not stamp:
        return None
    try:
        then = datetime.fromisoformat(stamp)
    except ValueError:
        return None
    return (datetime.now(then.tzinfo) - then).total_seconds() / 3600


def build_readings(cfg: dict, state: dict) -> list[Reading]:
    readings = []
    for key, spec in cfg["metrics"].items():
        entry = state.get(key) or {}
        unit = spec.get("unit", "count")
        readings.append(
            Reading(
                key=key,
                label=spec.get("label", key),
                value=entry.get("value"),
                threshold=spec["threshold"],
                direction=spec["direction"],
                unit=unit,
                note=entry.get("note", ""),
                history=entry.get("history"),
                days=entry.get("days"),
                stale_hours=hours_since(entry.get("written_at")),
                provisional=entry.get("provisional", False),
                denominator=entry.get("unit_denominator", 5),
            )
        )
    return readings


SPARK = "▁▂▃▄▅▆▇█"
SPARK_WIDTH = 14  # rolling-7 sampled once per day — a smooth trend, not 8 steps

# The 7-day strip: one cell per day of the rolling window, oldest on the left.
# NOT ●/○ — those are the status marks at the start of each row, and reusing them
# made the strip read as six more status dots. █ and ░ are the pair already proven
# on this terminal by the `left` build.
STRIP_HIT, STRIP_MISS, STRIP_UNKNOWN = "█", "░", "·"


def strip(days: list | None, width: int = 7) -> str:
    """One cell per day of the rolling window: did it happen, or not.

    ⚠️ This replaced an eighth-block sparkline that rendered as a SOLID BLACK BAR
    on 2026-08-11. A count metric sitting high and flat (journaling at 6–7 of 7)
    fills every cell to near-full height, and adjacent cells merge into an
    unbroken rectangle — unreadable, and it reads as a redaction. Anchoring the
    scale at zero was mathematically honest and visually wrong.

    A strip cannot brick: every cell is a discrete glyph on its own baseline. It
    also carries more information for a daily habit — *which* days were missed,
    not merely how many. Sparklines stay for continuous series (sleep hours),
    where the values actually vary.
    """
    if not days:
        return " " * (width * 2 - 1)
    cells = list(days)[-width:]
    marks = [STRIP_UNKNOWN if d is None else (STRIP_HIT if d else STRIP_MISS) for d in cells]
    pad = "  " * (width - len(cells))
    return pad + " ".join(marks)


def sparkline(values: list[float] | None, width: int = SPARK_WIDTH) -> str:
    """History as one row of blocks — the rolling-7 value sampled daily.

    Glyphs verified on Alex's terminal (Ghostty/JetBrains Mono) 2026-08-11 with a
    JAGGED test row — an ascending staircase hides misalignment, which is how the
    `left` build passed four checks and still looked wrong on screen.

    Always exactly `width` cells so every row's columns line up. Zero always
    renders as the floor glyph, so "did nothing" is visibly distinct from "did a
    little" even when the series is flat.

    ⚠️ `None` means NO DATA and renders as a BLANK cell, holding its position.
    It must never collapse into the floor glyph: on 2026-08-11 the first build
    drew five weeks of floor blocks for weeks that simply predated the Craft
    mirror, which reads as "you journaled nothing" instead of "we don't know."
    """
    if not values:
        return " " * width
    series = list(values)[-width:]
    pad = " " * (width - len(series))
    known = [v for v in series if v is not None]
    if not known:
        return " " * width
    top, bottom = max(known), min(known)
    # ⚠️ Scale to the OBSERVED RANGE, not to zero. Anchoring at zero is what made
    # the sleep row a solid black slab on 2026-08-13: seven nights between 6.3h
    # and 8.0h all land in the top eighth, every cell fills, and adjacent cells
    # merge into a rectangle. Nobody needs a chart to be told sleep is not zero —
    # the interesting variation is the 1.7h between his best night and his worst,
    # and only a range-scaled axis can show it.
    #
    # A genuine zero still renders as the floor: if the series touches 0, the
    # bottom of the range IS 0 and the scaling below puts it on SPARK[0].
    span = top - bottom
    out = []
    for v in series:
        if v is None:
            out.append(" ")
        elif span <= 0:
            # Truly flat. A mid-height row is honest; a full-height one is not.
            out.append(SPARK[len(SPARK) // 2])
        else:
            idx = round((v - bottom) / span * (len(SPARK) - 1))
            out.append(SPARK[max(0, min(idx, len(SPARK) - 1))])
    return pad + "".join(out)


def fmt_value(r: Reading) -> str:
    if r.missing:
        return "—"
    if r.unit == "hours":
        whole = int(r.value)
        mins = int(round((r.value - whole) * 60))
        return f"{whole}h{mins:02d}"
    if r.unit == "days7":
        return f"{int(r.value)}/7"
    if r.unit == "weekdays":
        return f"{int(r.value)}/{r.denominator}"
    if r.unit == "daysago":
        return f"{int(r.value)}d"
    v = r.value
    return str(int(v)) if float(v).is_integer() else f"{v:g}"


def fmt_threshold(r: Reading) -> str:
    sign = "≥" if r.direction == "min" else "≤"
    t = r.threshold
    if r.unit == "hours":
        return f"{sign}{t:g}h"
    if r.unit == "daysago":
        return f"{sign}{int(t)}d"
    return f"{sign}{int(t)}"


def render(cfg: dict, state: dict, color: bool = True) -> str:
    def c(code: str, text: str) -> str:
        return f"{code}{text}{RESET}" if color else text

    readings = build_readings(cfg, state)
    stale_limit = cfg.get("stale_after_hours", 26)
    mult = cfg.get("surge_multiplier", 1.5)

    since = date.today() - timedelta(days=6)
    lines = [""]
    lines.append(
        "  "
        + c(BOLD, "LAST 7 DAYS")
        + c(DIM, f"  {since:%b %-d}–{date.today():%b %-d}")
        + "      "
        + c(DIM, "● on track   ○ off   ▲ surging   — no data")
    )
    lines.append("")

    for r in readings:
        if r.missing:
            mark = c(DIM, "—")
        elif r.off_track:
            mark = c(RED, "○")
        elif r.surging(mult):
            mark = c(YELLOW, "▲")
        else:
            mark = c(GREEN, "●")

        note = r.note
        if r.stale_hours is not None and r.stale_hours > stale_limit:
            age = f"{int(r.stale_hours / 24)}d old" if r.stale_hours >= 48 else "stale"
            note = f"{note}  ({age})" if note else f"({age})"
        if r.provisional:
            note = f"{note}  [provisional]" if note else "[provisional]"

        chart = strip(r.days) if r.days else f"{sparkline(r.history, width=13):<13}"
        lines.append(
            f"  {mark} {r.label:<11}{fmt_value(r):<8}"
            + c(DIM, f"{fmt_threshold(r):<7}")
            + f"{c(DIM, chart)}   "
            + (c(DIM, note) if note else "")
        )

    lines.append("")
    countdown = read_left()
    if countdown:
        lines.append("  " + c(DIM, countdown))
        lines.append("")
    return "\n".join(lines)


def read_left() -> str:
    """The death clock, if it's installed. Same motivation layer, one surface."""
    import subprocess

    binary = Path.home() / ".local" / "bin" / "left"
    if not binary.exists():
        return ""
    try:
        out = subprocess.run(
            [str(binary)], capture_output=True, text=True, timeout=3
        )
    except (OSError, subprocess.SubprocessError):
        return ""
    return out.stdout.strip()


# Every row MUST be exactly 8 characters — the point of the test is column
# alignment, and a short row proves nothing. (Shipped 4-char rows once. Once.)
GLYPH_CANDIDATES = [
    ("eighth blocks — ascending", "▁▂▃▄▅▆▇█"),
    ("eighth blocks — jagged", "▃▇▂▆▁█▄▅"),
    ("full/empty (proven in left)", "████░░░░"),
    ("half blocks", "▄▀▄▀▄▀▄▀"),
    ("status dots", "●○●○◉◌◉◌"),
    ("triangles", "▲▼△▽▲▼△▽"),
    ("arrows", "↑↓→←↑↓→←"),
    ("shade ramp", "░░▒▒▓▓██"),
]


def glyph_test() -> str:
    """Print candidates so they can be LOOKED AT on the real terminal.

    Five iterations of `left` passed every check runnable in a terminal and still
    rendered wrong on screen. Nothing visual gets called done from a script.
    """
    out = ["", "  Each row must be exactly 8 cells wide and align with the others.", ""]
    out.append("  " + "12345678")
    out.append("  " + "-" * 8)
    for name, glyphs in GLYPH_CANDIDATES:
        out.append(f"  {glyphs:<8}  {name}")
    out.append("")
    out.append("  Look for: gaps, glyphs taller/shorter than the row, or")
    out.append("  anything that breaks the 8-cell column above.")
    out.append("")
    return "\n".join(out)


COLLECTORS = ("collect_local.py", "collect_api.py", "collect_outreach.py", "collect_fasting.py")


def repo_dir() -> Path:
    """The checkout, even when invoked through the ~/.local/bin symlink."""
    return Path(__file__).resolve().parent


def cmd_refresh() -> int:
    """Run every collector. One bad source must not stop the others."""
    import subprocess

    failed = []
    for name in COLLECTORS:
        script = repo_dir() / name
        if not script.exists():
            continue
        proc = subprocess.run(
            [sys.executable, str(script)], capture_output=True, text=True, timeout=300
        )
        for line in (proc.stdout or "").splitlines():
            print(f"  {line}")
        if proc.returncode != 0:
            failed.append(name)
            print(f"  ! {name} exited {proc.returncode}: {(proc.stderr or '').strip()[:160]}")
    return 1 if failed else 0


def cmd_journal() -> int:
    """The day-by-day the journal row is built from.

    This row ships `provisional` because agent-written prose in a daily note is
    not distinguishable from Alex's. Printing the reason per day is what makes
    that limit auditable instead of merely disclosed.
    """
    path = STATE_DIR / "local.json"
    if not path.exists():
        print("  no local state yet — run `habits refresh`")
        return 1
    detail = ((json.loads(path.read_text()).get("metrics") or {}).get("journal") or {}).get("detail")
    if not detail:
        print("  no journal detail recorded")
        return 1
    print()
    for row in detail:
        d = date.fromisoformat(row["date"])
        mark = "journaled" if row["journaled"] else "—        "
        label = f"{d:%a %b %-d}"
        print(f"  {label:<11}{mark}   {row['why']}")
    print()
    return 0


def cmd_fast(argv: list[str]) -> int:
    import subprocess

    script = repo_dir() / "collect_fasting.py"
    return subprocess.run([sys.executable, str(script), "record", *argv]).returncode


def main() -> int:
    ap = argparse.ArgumentParser(description="Weekly habit dashboard.")
    ap.add_argument("command", nargs="?", choices=["refresh", "journal", "fast"],
                    help="default: render the dashboard")
    ap.add_argument("--json", action="store_true", help="raw state as JSON")
    ap.add_argument("--glyph-test", action="store_true", help="print glyph candidates")
    ap.add_argument("--no-color", action="store_true", help="disable ANSI color")
    args, extra = ap.parse_known_args()

    if args.command == "fast":
        return cmd_fast(extra)
    if args.command == "journal":
        return cmd_journal()
    if args.command == "refresh":
        rc = cmd_refresh()
        print(render(load_config(), load_state(), color=sys.stdout.isatty()))
        return rc

    if args.glyph_test:
        print(glyph_test())
        return 0

    cfg = load_config()
    state = load_state()

    if args.json:
        print(json.dumps({"config": cfg, "state": state}, indent=2, default=str))
        return 0

    color = not args.no_color and sys.stdout.isatty()
    print(render(cfg, state, color=color))
    return 0


if __name__ == "__main__":
    sys.exit(main())
